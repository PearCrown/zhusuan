# Deployment environment example. Do not copy local database files or real .env into Git.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=platform.example.org
PRODUCTION_SITE_ORIGIN=https://platform.example.org
# true only behind a private proxy that overwrites X-Forwarded-Proto.
TRUST_HTTPS_PROXY=false
PRODUCTION_HSTS_SECONDS=3600
DB_NAME=huaxia_accounts
DB_USER=huaxia_app
DB_PASSWORD=
DB_HOST=database.example.org
DB_PORT=5432
DB_SSLROOTCERT=/run/certificates/database-ca.pem
DB_CONN_MAX_AGE=60
CONTACT_MESSAGE_BACKEND=disabled
