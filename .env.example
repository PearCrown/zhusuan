# Copy to .env. Generate fresh random values; never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=huaxia_accounts
DB_USER=huaxia_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55432
# Shared-IP registration attempts per fixed window. Includes invalid requests.
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=120
REGISTER_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=300
LOGIN_ACCOUNT_IP_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
# Absolute login lifetime, default 8 hours.
SESSION_AGE_SECONDS=28800
